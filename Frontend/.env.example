# Copia este archivo a .env.local y ajusta los valores.

# URL del backend FastAPI usada en el servidor (Server Components y Server Actions).
API_URL=http://localhost:8000

# Fallback de la URL del backend para código que corre en el navegador.
# Hoy todas las llamadas al backend se hacen desde el servidor, así que es opcional.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Usuario de prueba que vota cuando no hay cookie `pfx_uid` (modo demo, sin auth real).
# Se envía al backend en el header X-User-Id; requiere AUTH_MODE=demo en el backend.
# Si se deja vacío y no hay cookie, el detalle del curso pide iniciar sesión en lugar de mostrar el voto.
DEMO_USER_ID=1
